rules_version = '2';

// Paste these into Firebase console > Firestore Database > Rules, then Publish.
//
// signups:         anyone can read the lists; only a logged-in, verified, approved
//                   member can add a name. Only the person who added a name can remove it.
// schedules:        anyone can read who the head of an event is and the date/time they set.
//                   Only a logged-in member can become head. The first member to
//                   volunteer becomes head; only that person can change the date/time
//                   or step down.
// joinRequests:     anyone signed in (even anonymously) can submit a membership
//                   request; only the admin account can read, approve or deny them.
// approvedEmails:   a public "is this email approved" check (no names or IDs), used
//                   to gate account creation. Anyone can check one exact email; the
//                   full list can never be listed/downloaded. Only the admin can write.
// approvedMembers:  the full member record (name, tier, Member ID). A member can only
//                   read their own record; only the admin can read the whole list or write.
//
// Before this works, replace every ADMIN_UID below with your own admin User UID
// (see src/membership.config.js for how to get it), then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // A real (non-anonymous), verified account with an approved membership record.
    // Used to require members-only for joining events.
    function isMember() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/approvedMembers/$(request.auth.token.email));
    }

    match /joinRequests/{requestId} {
      allow create: if request.auth != null
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['name', 'email', 'tier', 'note', 'uid', 'status', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 60
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 3
        && request.resource.data.email.size() <= 100
        && request.resource.data.tier in ['peasant', 'mage', 'wizard']
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 300
        && request.resource.data.createdAt == request.time;

      allow read, update, delete: if request.auth != null && request.auth.uid == 'EFvCB38O8Pac40buJ6VP6tVa30x1';
    }

    match /approvedEmails/{email} {
      allow get: if true;
      allow list: if false;
      allow write: if request.auth != null && request.auth.uid == 'EFvCB38O8Pac40buJ6VP6tVa30x1';
    }

    match /approvedMembers/{email} {
      allow get: if request.auth != null
        && (request.auth.uid == 'EFvCB38O8Pac40buJ6VP6tVa30x1' || request.auth.token.email == email);
      allow list: if request.auth != null && request.auth.uid == 'EFvCB38O8Pac40buJ6VP6tVa30x1';
      allow write: if request.auth != null && request.auth.uid == 'EFvCB38O8Pac40buJ6VP6tVa30x1';
    }

    match /signups/{signupId} {
      allow read: if true;

      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['eventId', 'eventDate', 'name', 'uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 30
        && request.resource.data.eventId is string
        && request.resource.data.eventId.size() <= 80
        && request.resource.data.eventDate is string
        && request.resource.data.eventDate.size() == 10
        && request.resource.data.createdAt == request.time;

      allow update: if false;

      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /schedules/{listId} {
      allow read: if true;

      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['headUid', 'headName', 'date', 'time', 'updatedAt'])
        && request.resource.data.headUid == request.auth.uid
        && request.resource.data.headName is string
        && request.resource.data.headName.size() >= 1
        && request.resource.data.headName.size() <= 30
        && request.resource.data.date is string
        && (request.resource.data.date.size() == 0 || request.resource.data.date.size() == 10)
        && request.resource.data.time is string
        && request.resource.data.time.size() <= 20
        && request.resource.data.updatedAt == request.time;

      allow update: if isMember()
        && resource.data.headUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['headUid', 'headName', 'date', 'time', 'updatedAt'])
        && request.resource.data.headUid == resource.data.headUid
        && request.resource.data.headName == resource.data.headName
        && request.resource.data.date is string
        && (request.resource.data.date.size() == 0 || request.resource.data.date.size() == 10)
        && request.resource.data.time is string
        && request.resource.data.time.size() <= 20
        && request.resource.data.updatedAt == request.time;

      allow delete: if request.auth != null && resource.data.headUid == request.auth.uid;
    }
  }
}
